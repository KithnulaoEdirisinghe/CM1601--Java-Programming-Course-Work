<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="FX.DealerController"
            prefHeight="400.0" prefWidth="600.0">
   <children>
      <Label layoutX="31.0" layoutY="29.0" text="Dealers" />
      <Button layoutX="120.0" layoutY="25.0" mnemonicParsing="false" onAction="#handleRefresh" text="Refresh" />
      <TableView fx:id="dealerTable" AnchorPane.topAnchor="69.0" AnchorPane.bottomAnchor="9.0"
                 AnchorPane.leftAnchor="9.0" AnchorPane.rightAnchor="9.0">
        <columns>
          <TableColumn fx:id="dealerCode" prefWidth="100.0" text="Code" />
          <TableColumn fx:id="dealerName" prefWidth="150.0" text="Name" />
          <TableColumn fx:id="dealerPhone" prefWidth="120.0" text="Phone" />
          <TableColumn fx:id="dealerLocation" prefWidth="130.0" text="Location" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</AnchorPane>
