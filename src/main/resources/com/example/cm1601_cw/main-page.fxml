<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FX.MainController">
   <children>
      <Label layoutX="194.0" layoutY="14.0" text=" Malabe Tuk-Tuk &amp; Three-Wheeler Spares Depot">
         <font>
            <Font name="Times New Roman Bold Italic" size="25.0" />
         </font>
      </Label>
      <TabPane layoutX="16.0" layoutY="54.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="54.0">
        <tabs>
          <Tab text="Inventory">
            <content>
              <fx:include fx:id="inventoryView" source="inventory.fxml" />
            </content>
          </Tab>
          <Tab text="Inventory Manager">
            <content>
              <fx:include fx:id="manageItems" source="manage-items-view.fxml" />
            </content>
          </Tab>
            <Tab text="Dealers">
              <content>
                <fx:include fx:id="dealerView" source="dealer-view.fxml" />
              </content>
            </Tab>
            <Tab text="Search">
              <content>
                <fx:include fx:id="searchView" source="search-view.fxml" />
              </content>
            </Tab>
            <Tab text="Checkout">
                <content>
                    <fx:include fx:id="checkoutView" source="checkout-view.fxml"/>
                </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</AnchorPane>
